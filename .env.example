# SimReady Copilot — OpenAI-compatible LLM credentials
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Required: API key for an OpenAI-compatible endpoint.
# Works with OpenAI, OpenRouter, Anthropic-via-OpenRouter, local Ollama, etc.
OPENAI_API_KEY=<your-api-key>

# Optional: base URL override. Leave blank for OpenAI direct.
# If you choose another provider, replace both OPENAI_BASE_URL and OPENAI_MODEL
# and use a key for that provider. Examples:
# - Vultr: https://api.vultrinference.com/v1 (model: glm-5.3)
# - OpenRouter: https://openrouter.ai/api/v1
# - Local Ollama (OpenAI shim): http://localhost:11434/v1
OPENAI_BASE_URL=

# Required when the provider does not supply a client-side default.
# Choose a tool-calling model available at the endpoint above.
# OpenAI example: gpt-4o-mini. Vultr example: glm-5.3.
OPENAI_MODEL=
